{
  "manifest_version": 3,
  "name": "Mosaic",
  "version": "2.0.5",
  "description": "多平台 AI 模型协作工具，统一管理多个 AI 平台，支持多模型协作对话、流程编排和提示词管理",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost:*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove_xframe_options",
        "enabled": true,
        "path": "rules/remove-frame-options.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "utils/anti-lazy-load-deepseek.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "utils/platforms/base-adapter.js",
        "utils/platforms/deepseek-adapter.js",
        "utils/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.doubao.com/*"],
      "js": [
        "utils/anti-lazy-load-doubao.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.doubao.com/*"],
      "js": [
        "utils/platforms/base-adapter.js",
        "utils/platforms/doubao-adapter.js",
        "utils/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.qianwen.com/*"],
      "js": [
        "utils/anti-lazy-load-qianwen.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.qianwen.com/*"],
      "js": [
        "utils/platforms/base-adapter.js",
        "utils/platforms/qianwen-adapter.js",
        "utils/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.kimi.com/*"],
      "js": [
        "utils/anti-lazy-load-kimi.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.kimi.com/*"],
      "js": [
        "utils/platforms/base-adapter.js",
        "utils/platforms/kimi-adapter.js",
        "utils/content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["utils/floating-window.js", "utils/floating-content.js"],
      "run_at": "document_end",
      "exclude_matches": [
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://www.qianwen.com/*",
        "https://www.kimi.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/marked.min.js"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "utils/platforms/*.js",
        "utils/content-script.js"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "flow-designer/flow-designer.html",
        "flow-designer/flow-designer-page.js",
        "flow-designer/flow-designer-init.js",
        "flow-designer/flow-app.js",
        "flow-designer/flow-connections.js",
        "flow-designer/flow-types.js",
        "flow-designer/flow-runner.js",
        "flow-designer/flow-canvas-controller.js",
        "libs/leader-line.min.js",
        "styles/flow-designer.css",
        "styles/flow-designer-page.css",
        "utils/storage.js"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": [
        "dashboard/dashboard.html",
        "dashboard/dashboard.js",
        "dashboard/components/*.js",
        "styles/dashboard.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
